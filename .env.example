# Optional overrides — ticketqa-mcp has no required env vars.
# Authentication is per-request via three headers:
#   X-MSP-Token       Agent Platform access credential (JWT bearer token,
#                     already issued to the caller). Forwarded verbatim as
#                     "Authorization: Bearer <token>" to the TicketQA App API.
#   X-MSP-Tenant-Id   Tenant identifier. Forwarded to the downstream API as
#                     an "X_Tenant_ID" cookie (NOT a header) — this is how
#                     the platform's routing layer resolves which app/tenant
#                     a request belongs to. Undocumented in the source spec;
#                     confirmed empirically (a valid bearer token alone gets
#                     404 "App not found" without this cookie).
#   X-MSP-Host        Base host for the TicketQA App API, e.g.
#                     https://agentosint.mspbots.ai — this server appends
#                     "/apps/agent-ticket-qa/api/qa/<endpoint>" to it.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
